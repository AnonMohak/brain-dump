# Copy this file to .env and fill in the values. Never commit .env.

# OpenRouter API key, from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Models (OpenRouter model IDs)
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Reasoning for the model: none | low | medium | high.
# none is the fastest (first item in seconds). low/medium/high think first and can take 1-2 minutes.
OPENROUTER_REASONING_EFFORT=none

# Server. Keep HOST=127.0.0.1 for local use, so other devices cannot use your key.
HOST=127.0.0.1
PORT=3001

# SQLite database file
DATABASE_PATH=./data/sift.db

# Optional. When set, the app asks for this password before use.
APP_PASSWORD=
