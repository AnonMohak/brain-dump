# Values for the server (me-momo.co.in/sift). Copy this file to .env.production
# on your PC and fill it in. Git ignores .env.production. Claude copies the values
# to the server over SSH (/etc/sift/sift.env and /etc/sift/backup.env).
# Never paste these values into a chat.

# ---- App (goes to /etc/sift/sift.env)
# The same AI keys as in your local .env.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# The "Web application" OAuth client (not the "Desktop app" one from your local .env).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A new, long password for the login screen (it is not your local one).
APP_PASSWORD=
PUBLIC_URL=https://me-momo.co.in/sift
# Claude fills this in (a random value; the router gets the same value as a secret).
ORIGIN_KEY=

# ---- Cloudflare Tunnel (cloudflared on the server)
# Zero Trust -> Networks -> Tunnels -> your tunnel: the long value after "--token" (starts with eyJ).
TUNNEL_TOKEN=

# ---- Backups to Cloudflare R2 (goes to /etc/sift/backup.env)
# Your Account ID (R2 overview page, right side).
R2_ACCOUNT_ID=
R2_BUCKET=sift-backups
# R2 -> Manage API tokens -> Create API token (Object Read & Write, only this bucket).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
